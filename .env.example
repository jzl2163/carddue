# Do not run production with example credentials. Use: node scripts/init-env.mjs --domain card.example.com
APP_ENV=production
APP_BASE_URL=https://card.example.com
APP_DOMAIN=card.example.com
APP_BIND=0.0.0.0:8080
APP_PORT=8080
APP_ROLE=all
DEFAULT_TIMEZONE=Asia/Shanghai
POSTGRES_USER=carddue
POSTGRES_DB=carddue
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgres://carddue:REPLACE_WITH_RANDOM_PASSWORD@postgres:5432/carddue
# Each application key encodes exactly 32 cryptographically random bytes as unpadded base64url.
APP_ENCRYPTION_KEY=
ICS_SIGNING_KEY=
SETUP_TOKEN=
ALLOW_REGISTRATION=false
# Empty by default. Only explicitly named hosts may resolve to private addresses.
NOTIFICATION_PRIVATE_HOSTS=
ALLOW_INSECURE_NOTIFICATIONS=false
# Optional Web Push signing key: raw P-256 private scalar, unpadded base64url.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
FRONTEND_DIR=/app/frontend
RUST_LOG=carddue=info,tower_http=warn,sqlx=warn
# Secrets also support NAME_FILE instead of NAME; never set both.
