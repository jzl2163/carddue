{
  "name": "carddue-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prepare": "svelte-kit sync",
    "api:generate": "openapi-typescript openapi.json -o src/lib/generated/api.d.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "vite build",
    "budget": "node ../scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.0.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0",
    "tailwind-variants": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sveltejs/adapter-static": "^3.0.9",
    "@sveltejs/kit": "^2.37.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.9.0",
    "svelte": "^5.38.0",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
